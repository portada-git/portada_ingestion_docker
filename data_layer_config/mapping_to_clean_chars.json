{
      "numeric_map":{
        "^\\s*un.?\\s*$": "1",
        "^\\s*dos\\s*$": "2",
        "^\\s*tres\\s*$": "3",
        "^\\s*cuatro\\s*$": "4",
        "^\\s*cinco\\s*$": "5",
        "^\\s*seis\\s*$": "6",
        "^\\s*siete\\s*$": "7",
        "^\\s*ocho\\s*$": "8",
        "^\\s*nueve\\s*$": "9",
        "^\\s*(\\d+) *y? medi[oa]": "$1.5",
        "^\\s*(\\d+) *y? cuarto": "$1.25",
        "^\\s*(\\d+) *y? 1/4": "$1.25",
        "^\\s*(\\d+) *y? 1/2": "$1.5",
        "^\\s*(\\d+) *y? 3/4": "$1.75",
        "^nu[l1][l1]$": "null",
        "O": "0",
        "o": "0",
        "Q": "0",
        "C": "0",
        "I": "1",
        "l": "1",
        "|": "1",
        "!": "1",
        "Z": "2",
        "z": "2",
        "A": "4",
        "S": "5",
        "B": "8",
        "G": "6"
    },
    "only_text_map":{
       "0": "O",
       "1": "l",
       "2": "Z",
       "4": "A",
       "5": "S",
       "8": "B"
    },
    "one_word_map":{
       " ": "_",
       "\t": "_",
       "{": "",
       "}": "",
       "[": "",
       "]": "",
       "#": "",
       "\\.[^$]": "",
       ",": "",
       ";": "",
       "+": "t",
       "/": "l",
       "?": "P",
       "¿": "g",
       "!": "I",
       "(": "C",
       ")": "D",
       "@": "a",
       "|": "l",
       "¡": "l"
    },
    "not_paragraph_map":{
      "^[.,;]+\\s*": "",
       ";": ",",
       "{": "",
       "}": "",
       "[": "",
       "]": "",
       "#": "",
       "/": "l",
       "?": "P",
       "¿": "g",
       "!": "I",
       "(": "C",
       ")": "D",
       "@": "a",
       "|": "l",
       "¡": "l"
    },
    "master_role": {
      "(\\w+\\.?) [Dd](?:(?:\\.)|(?:[ocea][nm]))$": "$1",
      "e([.apn])": "c$1",
      "epn": "cpn"
    },
   "travel_duration_unit": {
     "([DdHh])\\s+(\\.)$": "$1$2",
     "^\\s*\\?\\s*$": "null"
   },
  "ship_tons_unit": {
    "^[^t].+": "t."
  },
  "travel_duration_value": {
    "^\\s*\\?\\?\\s*$": "null"
  },
  "travel_departure_port": {
    "^\\s*\\?\\?\\?\\?\\s*$": "null"
  },
  "ship_type": {
    "^\\s*\\?\\?\\?\\?\\s*$": "null"
  },
  "ship_name":{
     "^\\s*\\?\\?\\?\\?\\s*$": "null"
  },
  "ship_tons_capacity": {
     "^\\s*\\?\\?\\?\\?\\s*$": "null"
  },
  "master_name": {
     "^\\s*\\?\\?\\?\\?\\s*$": "null"
  }
}