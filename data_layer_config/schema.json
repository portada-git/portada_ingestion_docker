{
  "$id": "https://portadaproject.eu/ship_entry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ship_entry",
  "type": "object",
  "properties": {
    "entry_id": {
      "type": "string",
      "description": "Identificador único",
      "nullable": false,
      "for_cleaning":["not_cleanable"]
    },
    "temp_key": {
      "type": "string",
      "description": "Identificador único provisional",
      "nullable": false,
      "for_cleaning":["not_cleanable"]
    },
    "model_version": {
      "type": "string",
      "description": "Modelo de datos usado en una entrada.",
      "pattern": "^boat_fact-\\d{2}.\\d{2}.\\d{2}$",
      "nullable": false,
      "for_cleaning":["not_cleanable"]
    },
    "publication_name": {
      "type": "string",
      "description": "Nombre identificador del periodico desde donde se ha extraído la entrada.",
      "minLength": 2,
      "maxLength": 2,
      "nullable": false,
      "for_cleaning":["not_cleanable"]

    },
    "publication_date": {
      "type": "string",
      "description": "Fecha en la que se publicó la noticia de la entrada.",
      "format": "date",
      "nullable": false,
      "for_cleaning":["not_cleanable"]

    },
    "publication_edition": {
      "type": "string",
      "description": "Edición en la que se publicó la noticia de la entrada.",
      "minLength": 1,
      "maxLength": 1,
      "nullable": false,
      "for_cleaning":["not_cleanable"]
    },
    "news_section":{
      "type": "string",
      "description": "Sección de la noticia.",
      "nullable": false,
      "for_cleaning":["not_cleanable"]
    },
    "parsed_text": {
      "type": "string",
      "description": "Es el fragmento texto correspondiente a la entrada extraída publicado en el periodico, fecha y edición indicada.",
      "nullable": false,
      "for_cleaning":["paragraph"],
      "fill_with": {"type": "replace_if_not_exist", "from": "input_text"}
    },
    "travel_departure_date": {
      "type": "string",
      "description": "Fecha de salida del puerto en formato YYYY-MM-DD.",
      "format": "date",
      "nullable": true,
      "calculable_if_null": {"operation": "decrement_data", "parameters":{"origin_date": "travel_arrival_date", "decrement": "travel_duration_value", "decrement_unit": "travel_duration_unit"}}
    },
    "travel_arrival_date": {
      "type": "string",
      "description": "Fecha de llegada al puerto en formato YYYY-MM-DD.",
      "format": "date",
      "nullable": true
    },
    "travel_duration_value": {
      "type": "number",
      "description": "Duración del viaje en días o horas.",
      "nullable": true,
      "calculable_if_null": {"operation":  "data_difference", "parameters":{"origin_date": "travel_departure_date", "final_date":  "travel_arrival_date"}}
    },
    "travel_duration_unit": {
      "type": "string",
      "description": "Unidad de medida de la duración del viaje.",
      "nullable": true,
      "for_cleaning":["accepted_abbreviations", "not_digits", "one_word"],
      "fill_with": {"type": "replace_if_not_exist", "from": "LIT('d.')"}
    },
    "travel_departure_port": {
      "type": "string",
      "description": "Puerto desde el cual salió el barco.",
      "nullable": true,
      "for_cleaning":["accepted_idem", "not_digits"]
    },
    "travel_port_of_call_list": {
      "type": "array",
      "description": "Lista de puertos donde el barco hizo escala.",
      "items": {
        "type": "object",
        "properties": {
          "port_of_call_place": {
            "type": "string",
            "description": "Puerto donde hizo la escala.",
            "nullable": false,
            "for_cleaning": ["accepted_idem", "not_digits"]
          },
          "port_of_call_arrival_date": {
            "type": "string",
            "format": "date",
            "description": "Fecha de llegada al puerto de escala.",
            "nullable": true
          },
          "port_of_call_departure_date": {
            "type": "string",
            "format": "date",
            "description": "Fecha de llegada al puerto de escala.",
            "nullable": true
          }
        },
        "required": [
          "port_of_call_place"
        ],
        "additionalProperties": false
      },
      "normalize": {
        "type": "foreach_item",
        "options": [
          {
            "try_cast_to": {
              "type": "object",
              "properties":{
                "port_of_call_place": {
                  "type": "string"
                },
                "port_of_call_arrival_date": {
                  "type": "string"
                },
                "port_of_call_departure_date": {
                  "type": "string"
                }
              }
            },
            "equivalence": {
              "type": "struct",
              "new_value": {
                "port_of_call_place": {
                  "type": "column",
                  "value": "old_value.port_of_call_place"
                },
                "port_of_call_arrival_date": {
                  "type": "column",
                  "value": "old_value.port_of_call_arrival_date"
                },
                "port_of_call_departure_date": {
                  "type": "column",
                  "value": "old_value.port_of_call_departure_date"
                }
              }
            }
          },{
            "try_cast_to": {
              "type": "string"
            },
            "equivalence": {
              "type": "struct",
              "new_value": {
                "port_of_call_place": {
                  "type": "column",
                  "value": "old_value"
                },
                "port_of_call_arrival_date": {
                  "type": "literal",
                  "value": null
                },
                "port_of_call_departure_date": {
                  "type": "literal",
                  "value": null
                }
              }
            }
          }
        ],
        "otherwise":{
            "equivalence": {
              "type": "struct",
               "new_value": {
                "port_of_call_place": {
                  "type": "literal",
                  "value": null
                },
                "port_of_call_arrival_date": {
                  "type": "literal",
                  "value": null
                },
                "port_of_call_departure_date": {
                  "type": "literal",
                  "value": null
                }
              }
            }
        }
      }
    },
    "travel_arrival_port": {
      "type": "string",
      "description": "Puerto al que llegó el barco.",
      "nullable": true,
      "for_cleaning":["accepted_idem", "not_digits"]
    },
    "ship_type": {
      "type": "string",
      "description": "Tipo de embarcación.",
      "nullable": true,
      "for_cleaning":["accepted_abbreviations", "not_digits"]
    },
    "ship_name": {
      "type": "string",
      "description": "Nombre del barco.",
      "nullable": true
    },
    "ship_tons_capacity": {
      "type": "integer",
      "description": "Capacidad de carga del buque en toneladas. Debido a los posibles errores de transcripción del OCR, este dato se expresará como una cadena de caracteres. Si en la transcrición indicara, por ejemplo que el barco tiene una capacidad de 'B7 t.', en este campo deberá trasladarse el valor B7. Si se omitiera este valor dejaras este valor a null",
      "nullable": true
    },
    "ship_tons_unit": {
      "type": "string",
      "description": "Especifica las unidades en las que está expresado las dimensiones del buque. Normalmente toneladas, simbolizadas por la abreviación 't.'",
      "nullable": true,
      "for_cleaning":["accepted_abbreviations", "not_digits", "one_word"],
      "fill_with": {"type": "replace_if_not_exist", "from": "ship_tons_units"}
    },
    "ship_flag": {
      "type": "string",
      "description": "País o nacionalidad bajo cuya bandera navega el barco. Ejemplos: 'español', 'americano', 'oriental'",
      "nullable": true,
      "for_cleaning":["accepted_idem",  "not_digits"]
    },
    "master_role": {
      "type": "string",
      "description": "Cargo del responsable a bordo. Puede ser 'capitan' abreviado con c. o cap., 'piloto'abreviado con pil. o 'patrón' abreviado con p. o pat.",
      "nullable": true,
      "for_cleaning":["accepted_abbreviations", "not_digits", "one_word", "accepted_idem"]
    },
    "master_name": {
      "type": "string",
      "description": "Nombre del responsable a bordo.",
      "nullable": true
    },
    "broker_name": {
      "type": "string",
      "description": "Nombre del agente marítimo.",
      "nullable": true,
      "for_cleaning":["not_digits"]
    },
    "ship_agent_name": {
      "type": "string",
      "description": "Nombre del agente marítimo.",
      "nullable": true,
      "for_cleaning":["not_digits"]
    },
    "ship_agent_explicit": {
      "type": "boolean",
      "description": "Indica si el agente marítimo se indica de forma explícita en el texto.",
      "nullable": true
    },
    "cargo_list": {
      "type": "array",
      "description": "Lista de mercancías transportadas y sus propietarios.",
      "nullable": false,
      "items": {
        "type": "object",
        "properties": {
          "cargo_merchant_name": {
            "type": "string",
            "description": "Es el propietario de la carga o aquella persona a quien dicha carga va destinada.",
            "nullable": true,
            "for_cleaning":["not_digits", "accepted_idem"]
          },
          "cargo": {
            "type": "array",
            "description": "Lista de mercancías transportadas.",
            "nullable": false,
            "items": {
              "type": "object",
              "properties": {
                "cargo_quantity": {
                  "type": "number",
                  "description": "Representa la cantidad total de la carga en forma numérica. Se expresa como cadena de caracteres para evitar errores en el JSON si en la cantidad figuran letras en lugar de números debido a errores tipográficos o de transcripció del OCR. Si en la transcrición indicara, por ejemplo '2I pipas aceite', en este campo deberá trasladarse el valor 2I. Si el número no está presente, debe asignarse el valor null.",
                  "nullable": true,
                  "for_cleaning": ["accepted_idem"]
                },
                "cargo_unit": {
                  "type": "string",
                  "description": "Expresa las unidades de medida en las que la carga aparece. Ejemplo: 'cargo_unit': 'cj', 'cargo_unit':'barriles', 'cargo_unit': 'id'",
                  "nullable": true,
                  "for_cleaning":["accepted_abbreviations", "accepted_idem", "not_digits"]
                },
                "cargo_commodity": {
                  "type": "string",
                  "description": "Expresa los distintos productos o tipos de mercancías que transporta el buque. Ejemplo: 'cargo_commodity': 'cristales', 'cargo_commodity': 'id', 'cargo_commodity': 'vino'",
                  "nullable": true,
                  "for_cleaning":["accepted_abbreviations", "accepted_idem"]
                }
              },
              "required": ["cargo_quantity", "cargo_unit", "cargo_commodity"],
              "additionalProperties": false
            }
          }
        },
        "required": ["cargo_merchant_name", "cargo"],
        "additionalProperties": false
      },
      "fill_with": [
          {
            "type": "add_array_item",
            "from": [
                null,
                {
                  "type": "add_array_item",
                  "to": ["cargo_quantity", "cargo_unit", "cargo_commodity"],
                  "from": ["passengers", null, "LIT('pasajeros')"]
                }
            ],
            "to": ["cargo_merchant_name", "cargo"]
          },
          {
            "type": "add_array_item",
            "from": [
                null,
                {
                  "type": "add_array_item",
                  "to": ["cargo_quantity", "cargo_unit", "cargo_commodity"],
                  "from": [null, null, "LIT('en lastre')"]
                }
            ],
            "to": ["cargo_merchant_name", "cargo"],
            "condition": { "column": "in_ballast", "op": "==", "value": { "type": "l", "value": true } }
          }
      ]
    },
    "crew_number": {
      "type": "integer",
      "description": "Número de tripulantes.",
      "nullable": true
    },
    "quarantine": {
      "type": "boolean",
      "description": "Información relativa a la existencia de condiciones especiales de la llegada motivadas por circunstancias sanitarias que imponen la cuarentena.",
      "nullable": true
    },
    "forced_arrival": {
      "type": "boolean",
      "description": "Información sobre la llegada al puerto debido a causas imprevistas, como un arribo forzoso por temporal, avería u otras emergencias.",
      "nullable": true
    },
    "obs": {
      "type": "string",
      "description": "Notas o comentarios adicionales que aborden aspectos no contemplados en las variables registradas, proporcionando información contextual o relevante sobre el evento.",
      "nullable": true,
      "for_cleaning":["paragraph"],
      "fill_with": {"type": "replace_if_not_exist", "from": "ai_observations"}
    }
  },
  "required": [
    "travel_departure_date",
    "travel_arrival_date",
    "travel_departure_port",
    "travel_port_of_call_list",
    "travel_arrival_port",
    "ship_type",
    "ship_name",
    "ship_tons_capacity",
    "ship_tons_units",
    "ship_flag",
    "master_role",
    "master_name",
    "broker_name",
    "cargo_list",
    "quarantine",
    "forced_arrival",
    "obs"
  ],
  "additionalProperties": false,
  "order_and_partitions": {
    "order": ["publication_name", "publication_date", "publication_edition", "entry_id"],
    "partitions": ["publication_name", "publication_date", "publication_edition"]
  }
}